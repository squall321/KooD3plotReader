Bootstrap: docker
From: ubuntu:22.04

%labels
    Author       KooD3plotReader Team
    Version      2.4.0
    Description  LS-DYNA d3plot post-processing toolchain (headless, Slurm-ready) — DROP/IMPACT 통합

%help
    KooD3plotReader — Headless post-processing module.

    Bundled tools (PATH):
      unified_analyzer     — C++ d3plot analysis engine
      koo_deep_report      — Python single-sim report (HTML)
      koo_sphere_report    — Python all-angle sphere report (DROP cumulative)
      koo_impact_report    — Python multi-position partial-impact DOE report (IMPACT cumulative)
      koo_federate_report  — Python revision federate comparison (N sidecars → 1 report)
      post_analyze         — Bash orchestrator (unified → sphere|impact → deep, auto-detect by scenario.json)
      koo_dyna_diag        — LS-DYNA d3hsp/glstat/... 오류·성능 진단, HTML/JSON 리포트 (KooDynaDiag)
                             (상류 호환 심볼릭: koodyna → koo_dyna_diag)

    Usage:
      apptainer exec SmartTwinPostprocessor.sif unified_analyzer --help
      apptainer exec SmartTwinPostprocessor.sif post_analyze <test_dir>
      apptainer exec SmartTwinPostprocessor.sif koo_deep_report <d3plot_dir>

    With data bind:
      apptainer exec --bind /data:/data SmartTwinPostprocessor.sif \
          post_analyze /data/test_001 --section-view --section-view-backend lsprepost

    Headless rendering:
      - software backend (CPU, no GPU/display needed — recommended for headless):
          ... --section-view --section-view-backend software
      - lsprepost backend, GPU-accelerated (NVIDIA, VirtualGL):
          apptainer exec --nv --bind /data:/data SmartTwinPostprocessor.sif \
            env KOOD3PLOT_GPU_RENDER=1 post_analyze /data/test_001 \
            --section-view --section-view-backend lsprepost
        (requires --nv to bind the host NVIDIA driver; KOOD3PLOT_GPU_RENDER=1
         routes LSPrePost through `vglrun -d egl` + the non-mesa wrapper.
         Without --nv or the env, it falls back to software mesa GL.)

    Build:
      apptainer build SmartTwinPostprocessor.sif SmartTwinPostprocessor.def

%files
    # LSPrePost 바이너리 (호스트 installed/lsprepost/ → 컨테이너 /opt/_lsprepost_staging/)
    ../installed/lsprepost /opt/_lsprepost_staging

%post
    set -e

    # System dependencies
    apt-get update
    # 빌드 필수 패키지 (하나라도 빠지면 빌드 실패해야 하는 것들)
    apt-get install -y --no-install-recommends \
        build-essential cmake g++ git ca-certificates pkg-config wget \
        libomp-dev python3 python3-pip python3-venv libpython3.10 \
        ffmpeg libpng-dev xvfb \
        libgl1 libglu1-mesa libxrandr2 libxi6 libxcursor1 \
        libxinerama1 libxkbcommon0 \
        libgtk-3-0 libnotify4 libsecret-1-0
    # libpython3.10: PyInstaller onefile 빌드 시 필요 (koo_dyna_diag)
    # libgtk-3-0 libnotify4 libsecret-1-0: LSPrePost 가 링크하는 libgtk-3/gdk-3/atk-1.0/
    #   notify/secret 은 lsprepost 번들(lib, mesa_lib)에 **없다**. 빠지면 렌더가
    #   "libgtk-3.so.0: cannot open shared object file" (exit 127) 로 죽고 영상 0개.
    #   (2026-09-17 SIF c6ef4ca 에서 재현, 이 3개 설치 후 헤드리스 렌더 성공 확인.
    #    6/26 의 "번들에 있음" 판정은 호스트 ldd 가 호스트 GTK 를 찾은 착각이었다.)

    # --- GPU 렌더(VirtualGL) — best-effort, 실패해도 빌드 안 죽음 ---
    # GLX 전용 LSPrePost 를 헤드리스 GPU 로 가속하는 경로(KOOD3PLOT_GPU_RENDER=1
    # + apptainer --nv 일 때만 사용). virtualgl 은 Ubuntu 기본 repo 에 없어
    # GitHub 릴리스 .deb 로 설치. EGL 런타임(libglvnd/libegl)은 vglrun 의 EGL
    # 백엔드용 — 패키지명이 배포본마다 달라 개별 설치 후 실패는 무시.
    # 모두 실패해도 SW/mesa 렌더 경로는 정상 동작하므로 빌드는 계속 진행.
    for p in libegl1 libegl-mesa0 libgles2 libglvnd0 libgl1-mesa-dri; do
        apt-get install -y --no-install-recommends "$p" 2>/dev/null \
            || echo "WARN: optional GPU pkg '$p' 설치 실패 (skip)"
    done
    VGL_DEB=/tmp/virtualgl.deb
    if wget -q -O "$VGL_DEB" \
         "https://github.com/VirtualGL/virtualgl/releases/download/3.1.1/virtualgl_3.1.1_amd64.deb"; then
        apt-get install -y --no-install-recommends "$VGL_DEB" \
            || echo "WARN: VirtualGL .deb 설치 실패 — GPU 렌더 비활성(SW/mesa 정상)"
    else
        echo "WARN: VirtualGL .deb 다운로드 실패 — GPU 렌더 비활성(SW/mesa 정상)"
    fi
    rm -f "$VGL_DEB"

    # Clone source and build
    cd /opt
    git clone --depth 1 https://github.com/squall321/KooD3plotReader.git
    cd KooD3plotReader

    # Build module (headless: no viewer, no Nuitka to keep size small).
    # --section-render: 자체 SW 섹션렌더(CPU, GTK/GPU/디스플레이 불요) 강제 ON.
    # 자동감지 의존 제거 — 과거 빌드에서 OFF 로 떨어져 "software renderer not
    # available" stub 가 출고되던 회귀 방지.
    ./scripts/build_module.sh --prefix /opt/kood3plot --no-viewer --section-render

    # LSPrePost: %files 에서 staging 으로 복사된 것을 최종 위치로 이동
    if [ -d /opt/_lsprepost_staging ]; then
        mkdir -p /opt/kood3plot/lsprepost
        cp -r /opt/_lsprepost_staging/* /opt/kood3plot/lsprepost/

        # 호스트 installed/lsprepost 는 .gitignore 대상이라 수작업 산출물이다.
        # lib/ 만 있고 161MB 본 바이너리가 빠진 부분 동기화를 여기서 막는다.
        # 놓치면 래퍼(lspp412_mesa)만 남아 LSPrePostRenderer::isAvailable() 이 true 를
        # 돌려주고, 실행 시점에 exit 127 로 죽어 libgtk 누락과 증상이 구분되지 않는다.
        if [ ! -f /opt/kood3plot/lsprepost/lsprepost ]; then
            echo "ERROR: LSPrePost 본 바이너리 없음 — 호스트 installed/lsprepost 부분 동기화?"
            ls -la /opt/kood3plot/lsprepost/ || true
            exit 1
        fi
        chmod +x /opt/kood3plot/lsprepost/lsprepost
        sed -i 's/^LSPrePost:.*/LSPrePost:  bundled/' /opt/kood3plot/VERSION 2>/dev/null || true
        rm -rf /opt/_lsprepost_staging
        echo "LSPrePost bundled → /opt/kood3plot/lsprepost/"

        # 래퍼(lspp412_mesa)와 같은 라이브러리 경로에서 풀리지 않는 공유 라이브러리가
        # 하나라도 있으면 렌더가 실행 시점에 죽는다 — 빌드에서 막는다.
        # grep "not found" 만으로는 부족하다: ldd 는 파일이 없으면
        # "No such file or directory", 동적 실행 파일이 아니면
        # "not a dynamic executable" 을 내는데 둘 다 "not found" 를 담지 않는다.
        lspp_ldd=$(LD_LIBRARY_PATH=/opt/kood3plot/lsprepost/mesa_lib:/opt/kood3plot/lsprepost/lib \
                   ldd /opt/kood3plot/lsprepost/lsprepost 2>&1 || true)
        case "${lspp_ldd}" in
            *"not found"*|*"No such file"*|*"not a dynamic executable"*)
                echo "ERROR: LSPrePost 공유 라이브러리 확인 실패 (apt 목록 확인):"
                echo "${lspp_ldd}"
                exit 1 ;;
        esac
        if [ -z "${lspp_ldd}" ]; then
            echo "ERROR: ldd 출력이 비어 LSPrePost 라이브러리를 검사하지 못했습니다"
            exit 1
        fi
    fi

    # Cleanup: remove build artifacts and source (keep only /opt/kood3plot)
    rm -rf /opt/KooD3plotReader/build
    # .git 을 지우면 남은 소스가 어느 판인지 알 수 없게 된다. 실제로 이 소스를
    # 읽고 "기능이 없다" 고 판단한 오판이 있었다
    # (docs/postproc_gap_2026-09/plan.md §0). 표식을 소스 트리에 남긴다.
    cp /opt/kood3plot/VERSION /opt/KooD3plotReader/VERSION 2>/dev/null || true
    rm -rf /opt/KooD3plotReader/.git

    # Install runtime Python deps (for non-Nuitka wrapper mode).
    # lasso-python: binout(matsum/rcforc) 리더 — 부재 시 koo_impact_report 의
    # 에너지 파이프라인 전체가 무음으로 빈 값이 됐던 원인 (2026-07 진단 확정,
    # docs/impact-sota-context-notes.md). 이제 1급 의존성으로 하드 설치.
    pip install --no-cache-dir rich pyyaml lasso-python

    # --- KooDynaDiag (koo_dyna_diag) 통합 ---
    # LS-DYNA 결과 진단/리포트 도구 (원 리포지토리: KooDynaErrorAnalyzer,
    # 프로젝트명 KooDynaDiag). 다른 Post 모듈처럼 소스 clone → 컨테이너
    # 안에서 PyInstaller onefile 빌드 → /opt/kood3plot/bin 에 배치.
    # 명명: Post 모듈 컨벤션(koo_X_Y)에 맞춰 `koo_dyna_diag`. 상류 호환을
    # 위해 `koodyna` 심볼릭 링크도 함께 배치.
    cd /opt
    git clone --depth 1 https://github.com/squall321/KooDynaErrorAnalyzer.git
    cd KooDynaErrorAnalyzer

    # BUILD_DATE 갱신 (build_linux.sh 관례)
    sed -i "s/^BUILD_DATE = .*/BUILD_DATE = \"$(date +%Y-%m-%d)\"/" \
        src/koodyna/__init__.py 2>/dev/null || true

    pip install --no-cache-dir pyinstaller
    export PYTHONPATH="/opt/KooDynaErrorAnalyzer/src"
    pyinstaller --onefile --name koo_dyna_diag \
        --collect-all koodyna \
        --paths src \
        src/koodyna/__main__.py

    install -m 755 dist/koo_dyna_diag /opt/kood3plot/bin/koo_dyna_diag
    # 상류 이름(koodyna) 호환용 심볼릭
    ln -sf koo_dyna_diag /opt/kood3plot/bin/koodyna

    # 소스/빌드 잔재 제거
    cd /opt
    rm -rf /opt/KooDynaErrorAnalyzer

    apt-get clean
    rm -rf /var/lib/apt/lists/*

%environment
    export KOOD3PLOT_HOME=/opt/kood3plot
    export PATH=/opt/kood3plot/bin:$PATH
    export PYTHONPATH=/opt/kood3plot/python/koo_deep_report:/opt/kood3plot/python/koo_sphere_report:/opt/kood3plot/python/koo_impact_report:/opt/kood3plot/python/koo_federate_report:/opt/kood3plot/python/koo_custom_report
    export LSPREPOST_PATH=/opt/kood3plot/lsprepost
    export OMP_NUM_THREADS=${SLURM_CPUS_PER_TASK:-4}
    # VirtualGL EGL 백엔드 기본 GPU 디바이스(헤드리스). KOOD3PLOT_GPU_RENDER=1
    # 일 때만 vglrun 이 사용. GPU 모드 OFF 면 무영향.
    export VGL_DISPLAY=egl

%runscript
    if [ $# -eq 0 ]; then
        cat /opt/kood3plot/VERSION
        echo ""
        echo "Usage: apptainer exec SmartTwinPostprocessor.sif <command> [args]"
        echo "Commands: unified_analyzer, koo_deep_report, koo_sphere_report, koo_impact_report, koo_federate_report, post_analyze, koo_dyna_diag"
        exit 0
    fi
    exec "$@"

%test
    # apptainer 는 이 절을 /bin/sh 로 돌리면서 set -e 를 넣어 주지 않는다. 없으면
    # 중간의 `test -x` 가 실패해도 마지막 echo 가 종료코드 0 을 돌려준다 — 실제로
    # 생성된 /.singularity.d/test 에 set -e 가 없음을 확인했다.
    set -e
    /opt/kood3plot/bin/unified_analyzer --help >/dev/null
    # LSPrePost 본 바이너리 존재를 무조건 확인한다. `[ -x … ] &&` 를 가드로 앞에 두면
    # 바이너리가 없을 때 조건 전체가 거짓이 되어 검사가 스스로 비켜선다.
    if [ ! -x /opt/kood3plot/lsprepost/lsprepost ]; then
        echo "ERROR: LSPrePost 본 바이너리 없음: /opt/kood3plot/lsprepost/lsprepost"
        exit 1
    fi
    # ldd 는 파일이 없거나 동적 실행 파일이 아니면 "not found" 를 내지 않는다.
    # grep "not found" 만 보면 그 경우를 통째로 놓친다 — 출력 전체를 본다.
    lspp_ldd=$(LD_LIBRARY_PATH=/opt/kood3plot/lsprepost/mesa_lib:/opt/kood3plot/lsprepost/lib \
               ldd /opt/kood3plot/lsprepost/lsprepost 2>&1 || true)
    case "${lspp_ldd}" in
        *"not found"*|*"No such file"*|*"not a dynamic executable"*)
            echo "ERROR: LSPrePost 공유 라이브러리 확인 실패:"
            echo "${lspp_ldd}"
            exit 1 ;;
    esac
    if [ -z "${lspp_ldd}" ]; then
        echo "ERROR: ldd 출력이 비어 LSPrePost 라이브러리를 검사하지 못했습니다"
        exit 1
    fi
    /opt/kood3plot/bin/koo_deep_report --help >/dev/null
    /opt/kood3plot/bin/koo_sphere_report --help >/dev/null
    /opt/kood3plot/bin/koo_impact_report --help >/dev/null
    /opt/kood3plot/bin/koo_federate_report --help >/dev/null
    /opt/kood3plot/bin/koo_custom_report --help >/dev/null
    /opt/kood3plot/bin/koo_dyna_diag --help >/dev/null
    # make_stl 이 빠지면 실형상 미리보기가 개략도로 폴백한다 (과거 실제 사고)
    test -x /opt/kood3plot/bin/make_stl
    # %environment 의 PYTHONPATH 가 5개 패키지를 다 담는지 — python3 -m 직접 호출 경로
    for _p in koo_deep_report koo_sphere_report koo_impact_report koo_federate_report koo_custom_report; do
        python3 -c "import ${_p}" || exit 1
    done
    # 상류 호환 심볼릭 검증
    /opt/kood3plot/bin/koodyna --help >/dev/null
    echo "All tools available"
